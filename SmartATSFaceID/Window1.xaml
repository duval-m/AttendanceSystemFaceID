<Window x:Class="Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartATSFaceID"
        mc:Ignorable="d"
        Title="Dashboard" Height="600" Width="920">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <LinearGradientBrush.RelativeTransform>
                <TransformGroup>
                    <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                    <SkewTransform CenterX="0.5" CenterY="0.5"/>
                    <RotateTransform Angle="-51" CenterX="0.5" CenterY="0.5"/>
                    <TranslateTransform/>
                </TransformGroup>
            </LinearGradientBrush.RelativeTransform>
            <GradientStop Color="#FF041367"/>
            <GradientStop Color="#FF556DEF" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid HorizontalAlignment="Left" Width="667" Margin="253,0,0,0" Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Image x:Name="smartATSLogo" HorizontalAlignment="Left" Height="69" Margin="-164,15,0,0" VerticalAlignment="Top" Width="68" Source="/Images/logo_face_id.png" RenderTransformOrigin="-2.414,-0.858"/>
        <Label x:Name="titleLabel" Content="SMART ATTENDANCE  SYSTEM" HorizontalAlignment="Left" VerticalAlignment="Top" Width="198" FontFamily="Agency FB" Foreground="White" Margin="-225,94,0,0" Height="61" FontSize="20"/>
        <Button Content="EMPLOYE" HorizontalAlignment="Left" Height="48" Margin="-206,254,0,0" VerticalAlignment="Top" Width="152" FontFamily="Dubai Medium" FontSize="26" BorderBrush="White" Background="{x:Null}" Foreground="White" Click="Button_Click"/>
        <Image HorizontalAlignment="Left" Height="201" Margin="31,103,0,0" VerticalAlignment="Top" Width="185" Source="/12.jpg" Grid.Column="1" Stretch="Fill" />
        <Button Content="ADMIN" HorizontalAlignment="Left" Height="48" Margin="-206,327,0,0" VerticalAlignment="Top" Width="152" FontFamily="Dubai Medium" FontSize="26" BorderBrush="White" Background="{x:Null}" Foreground="White" Click="Button_Click"/>
        <Button Content="ACCUEIL" HorizontalAlignment="Left" Height="48" Margin="-206,179,0,0" VerticalAlignment="Top" Width="152" FontFamily="Dubai Medium" FontSize="26" BorderBrush="{x:Null}" Background="{x:Null}" Foreground="White" Click="Button_Click"/>
        <Button Content="LOG OUT" HorizontalAlignment="Left" Height="48" Margin="-206,508,0,0" VerticalAlignment="Top" Width="152" FontFamily="Dubai Medium" FontSize="26" BorderBrush="White" Background="#FFD42424" Foreground="White" Click="Button_Click"/>
        <Rectangle Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="201" Margin="31,103,0,0" Stroke="#FF3515E3" VerticalAlignment="Top" Width="185" StrokeThickness="3"/>
        <TextBox Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="49" Margin="253,173,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="373" Background="White" Foreground="White" SelectionBrush="White" BorderBrush="#FF0D48F9" FontFamily="Dubai Medium" FontSize="26"/>
        <Label Content="Mot de passe de session" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="44" Margin="253,132,0,0" VerticalAlignment="Top" Width="345" FontFamily="Dubai Medium" FontSize="20"/>
        <Button Content="Lancer une session" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="62" Margin="290,257,0,0" VerticalAlignment="Top" Width="299" FontFamily="Dubai Medium" FontSize="26" Background="#FF7BA1C3"/>
        <Border BorderBrush="Black" BorderThickness="0,0,0,1" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="44" Margin="237,58,0,0" VerticalAlignment="Top" Width="397"/>
        <Label Content="Bienvenue, Admin Duval" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="44" Margin="233,58,0,0" VerticalAlignment="Top" Width="373"  FontFamily="Dubai Medium" FontSize="26"/>
        <Label Content="DASHBOARD" HorizontalAlignment="Left" Height="44" Margin="31,10,0,0" VerticalAlignment="Top" Width="196"  FontFamily="Franklin Gothic Heavy" FontSize="30" Grid.Column="1" Foreground="#FF004BF0"/>
        <Border BorderBrush="#FF0087FF" BorderThickness="0,0,0,3" HorizontalAlignment="Left" Height="44" Margin="31,12,0,0" VerticalAlignment="Top" Width="616" Grid.Column="1"/>
        <Button Content="How to use ?" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="38" Margin="40,313,0,0" VerticalAlignment="Top" Width="166" FontFamily="Dubai Medium" FontSize="20" Background="#FFEEF0F6"/>
        <Label Content="STATISTIQUES" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="44" Margin="267,342,0,0" VerticalAlignment="Top" Width="345" FontFamily="Dubai Medium" FontSize="20"/>
        <Border BorderBrush="Black" BorderThickness="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="174" Margin="255,382,0,0" VerticalAlignment="Top" Width="375" />
        <Border BorderBrush="#FF5158A1" BorderThickness="1" HorizontalAlignment="Left" Height="39" Margin="539,404,0,0" VerticalAlignment="Top" Width="73" Grid.ColumnSpan="2"/>
        <Label Content="Période" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="44" Margin="10,410,0,0" VerticalAlignment="Top" Width="345" FontFamily="Dubai Medium" FontSize="26"/>
        <ComboBox Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="49" Margin="10,454,0,0" VerticalAlignment="Top" Width="217" Background="White" BorderBrush="White"/>
        <Button Content="Génerer un rapport" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="48" Margin="16,510,0,0" VerticalAlignment="Top" Width="201" FontFamily="Dubai Medium" FontSize="24" Background="#FFA6B9F4"/>
        <Label Content="Employé ajouter&#xD;&#xA;Employé en service&#xD;&#xA;Employé absent" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="143" Margin="263,395,0,0" VerticalAlignment="Top" Width="275"  FontFamily="Dubai Medium" FontSize="26"/>
        <Label Content="25" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="37" Margin="543,402,0,0" VerticalAlignment="Top" Width="66" FontFamily="Dubai Medium" FontSize="24" Foreground="#FF4C27CB" BorderBrush="#FF0D3789"/>
        <Border BorderBrush="#FF5158A1" BorderThickness="1" HorizontalAlignment="Left" Height="39" Margin="539,450,0,0" VerticalAlignment="Top" Width="74" Grid.ColumnSpan="2"/>
        <Label Content="25" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="37" Margin="544,448,0,0" VerticalAlignment="Top" Width="66" FontFamily="Dubai Medium" FontSize="24" Foreground="#FF4C27CB" BorderBrush="#FF0D3789"/>
        <Border BorderBrush="#FF5158A1" BorderThickness="1" HorizontalAlignment="Left" Height="39" Margin="539,496,0,0" VerticalAlignment="Top" Width="73" Grid.ColumnSpan="2"/>
        <Label Content="25" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="37" Margin="542,494,0,0" VerticalAlignment="Top" Width="66" FontFamily="Dubai Medium" FontSize="24" Foreground="#FF4C27CB" BorderBrush="#FF0D3789"/>
    </Grid>
</Window>
