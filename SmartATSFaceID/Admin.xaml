<Window x:Class="Admin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartATSFaceID"
        mc:Ignorable="d"
        Title="Admin" Height="600" Width="920">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <LinearGradientBrush.RelativeTransform>
                <TransformGroup>
                    <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                    <SkewTransform CenterX="0.5" CenterY="0.5"/>
                    <RotateTransform Angle="-51" CenterX="0.5" CenterY="0.5"/>
                    <TranslateTransform/>
                </TransformGroup>
            </LinearGradientBrush.RelativeTransform>
            <GradientStop Color="#FF041367"/>
            <GradientStop Color="#FF556DEF" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid HorizontalAlignment="Left" Width="667" Margin="253,0,0,0" Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Image x:Name="smartATSLogo" HorizontalAlignment="Left" Height="69" Margin="-164,15,0,0" VerticalAlignment="Top" Width="68" Source="/Images/logo_face_id.png" RenderTransformOrigin="-2.414,-0.858"/>
        <Label x:Name="titleLabel" Content="SMART ATTENDANCE  SYSTEM" HorizontalAlignment="Left" VerticalAlignment="Top" Width="198" FontFamily="Agency FB" Foreground="White" Margin="-225,94,0,0" Height="61" FontSize="20"/>
        <Button Content="EMPLOYE" HorizontalAlignment="Left" Height="48" Margin="-206,254,0,0" VerticalAlignment="Top" Width="152" FontFamily="Dubai Medium" FontSize="26" BorderBrush="White" Background="{x:Null}" Foreground="White" Click="Button_Click"/>
        <Button Content="ADMIN" HorizontalAlignment="Left" Height="48" Margin="-206,327,0,0" VerticalAlignment="Top" Width="152" FontFamily="Dubai Medium" FontSize="26" BorderBrush="{x:Null}" Background="{x:Null}" Foreground="White" Click="Button_Click"/>
        <Button Content="ACCUEIL" HorizontalAlignment="Left" Height="48" Margin="-206,179,0,0" VerticalAlignment="Top" Width="152" FontFamily="Dubai Medium" FontSize="26" BorderBrush="White" Background="{x:Null}" Foreground="White" Click="Button_Click"/>
        <Button Content="LOG OUT" HorizontalAlignment="Left" Height="48" Margin="-206,508,0,0" VerticalAlignment="Top" Width="152" FontFamily="Dubai Medium" FontSize="26" BorderBrush="White" Background="#FFD42424" Foreground="White" Click="Button_Click"/>
        <TextBox Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="49" Margin="38,117,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="180" Background="White" Foreground="White" SelectionBrush="White" BorderBrush="#FF0D48F9" FontFamily="Dubai Medium" FontSize="26"/>
        <Label Content="Gestion Admin" HorizontalAlignment="Left" Height="44" Margin="31,10,0,0" VerticalAlignment="Top" Width="264"  FontFamily="Franklin Gothic Heavy" FontSize="30" Grid.Column="1" Foreground="#FF004BF0"/>
        <Border BorderBrush="#FF0087FF" BorderThickness="0,0,0,3" HorizontalAlignment="Left" Height="44" Margin="31,12,0,0" VerticalAlignment="Top" Width="616" Grid.Column="1"/>
        <Label Content="Listes des Admins" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="44" Margin="161,254,0,0" VerticalAlignment="Top" Width="219" FontFamily="Dubai Medium" FontSize="25" Foreground="#FF1532F1"/>
        <Label Content="Nom" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="44" Margin="38,68,0,0" VerticalAlignment="Top" Width="64" FontFamily="Dubai Medium" FontSize="26"/>
        <Button Content="Ajouter" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="38" Margin="41,185,0,0" VerticalAlignment="Top" Width="133" FontFamily="Dubai Medium" FontSize="24" Background="#FFA6B9F4"/>
        <TextBox HorizontalAlignment="Center" Height="49" Margin="0,117,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="180" Background="White" Foreground="White" SelectionBrush="White" BorderBrush="#FF0D48F9" FontFamily="Dubai Medium" FontSize="26" Grid.Column="1"/>
        <Label Content="Adresse Gmail" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="44" Margin="243,68,0,0" VerticalAlignment="Top" Width="167" FontFamily="Dubai Medium" FontSize="26"/>
        <Label Content="Password" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="44" Margin="439,68,0,0" VerticalAlignment="Top" Width="118" FontFamily="Dubai Medium" FontSize="26"/>
        <TextBox Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="49" Margin="439,117,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="180" Background="White" Foreground="White" SelectionBrush="White" BorderBrush="#FF0D48F9" FontFamily="Dubai Medium" FontSize="26"/>
        <Button Content="Ajouter" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="38" Margin="41,185,0,0" VerticalAlignment="Top" Width="133" FontFamily="Dubai Medium" FontSize="24" Background="#FFA6B9F4"/>
        <Button Content="Réinitialiser" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="38" Margin="477,185,0,0" VerticalAlignment="Top" Width="133" FontFamily="Dubai Medium" FontSize="24" Background="#FFA6B9F4"/>
        <Button Content="Supprimer" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="38" Margin="332,185,0,0" VerticalAlignment="Top" Width="133" FontFamily="Dubai Medium" FontSize="24" Background="#FFA6B9F4"/>
        <Button Content="Modifier" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="38" Margin="187,185,0,0" VerticalAlignment="Top" Width="133" FontFamily="Dubai Medium" FontSize="24" Background="#FFA6B9F4"/>
        <TextBox Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="37" Margin="420,252,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="180" Background="White" Foreground="White" SelectionBrush="White" BorderBrush="#FF0D48F9" FontFamily="Dubai Medium" FontSize="26"/>
        <Image Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="40" Margin="608,252,0,0" VerticalAlignment="Top" Width="47" Source="/icons8-chercher.gif"/>
        <DataGrid Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="223" Margin="31,309,0,0" VerticalAlignment="Top" Width="597" d:ItemsSource="{d:SampleData ItemCount=5}">
            <DataGrid.CellStyle>
                <Style/>
            </DataGrid.CellStyle>
        </DataGrid>
    </Grid>
</Window>